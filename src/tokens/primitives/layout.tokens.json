{
  "$description": "Keel primitive spacing and radius. Spacing is a 4px grid; the token name is the multiple of 4 (space.3 = 12px).",
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "0-5": { "$value": { "value": 2, "unit": "px" }, "$description": "Hairline offsets only (focus ring gap, icon nudge)" },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } },
    "24": { "$value": { "value": 96, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "sm": { "$value": { "value": 4, "unit": "px" }, "$description": "Checkboxes, badges, tags" },
    "md": { "$value": { "value": 6, "unit": "px" }, "$description": "Small controls" },
    "lg": { "$value": { "value": 8, "unit": "px" }, "$description": "Buttons, inputs, selects" },
    "xl": { "$value": { "value": 12, "unit": "px" }, "$description": "Cards, popovers" },
    "2xl": { "$value": { "value": 16, "unit": "px" }, "$description": "Dialogs, large panels" },
    "full": { "$value": { "value": 9999, "unit": "px" }, "$description": "Pills, avatars, switches" }
  }
}
