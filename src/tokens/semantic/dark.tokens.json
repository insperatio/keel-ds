{
  "$description": "Keel semantic tokens, dark mode. Same names as light.tokens.json, re-pointed at the dark end of the ramps. Every value is an alias to a primitive.",
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": "{color.neutral.50}",
        "$description": "Body text and headings"
      },
      "secondary": {
        "$value": "{color.neutral.300}",
        "$description": "Supporting text, descriptions"
      },
      "tertiary": {
        "$value": "{color.neutral.400}",
        "$description": "Captions, metadata, placeholders"
      },
      "disabled": {
        "$value": "{color.neutral.600}",
        "$description": "Disabled labels only (exempt from contrast rules)"
      },
      "inverse": {
        "$value": "{color.neutral.900}",
        "$description": "Text on surface.inverse"
      },
      "link": {
        "$value": "{color.accent.300}"
      },
      "link-hover": {
        "$value": "{color.accent.200}"
      },
      "danger": {
        "$value": "{color.red.300}",
        "$description": "Error messages"
      },
      "success": {
        "$value": "{color.green.300}"
      },
      "warning": {
        "$value": "{color.amber.300}"
      }
    },
    "surface": {
      "page": {
        "$value": "{color.neutral.950}",
        "$description": "App background"
      },
      "subtle": {
        "$value": "{color.neutral.900}",
        "$description": "Sidebars, table headers, quiet sections"
      },
      "raised": {
        "$value": "{color.neutral.900}",
        "$description": "Cards (pair with border.subtle or shadow.md)"
      },
      "sunken": {
        "$value": "{color.base.black}",
        "$description": "Code blocks and wells, darker than the page"
      },
      "overlay": {
        "$value": "{color.neutral.900}",
        "$description": "Popovers, menus, dialogs. Same fill as cards in dark mode; separate them with border.default and shadow.lg or xl. (neutral.800 dropped tertiary text to 4.48:1.)"
      },
      "inverse": {
        "$value": "{color.neutral.50}",
        "$description": "Tooltips, toasts on light pages"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.800}",
        "$description": "Dividers, card outlines (decorative)"
      },
      "default": {
        "$value": "{color.neutral.700}",
        "$description": "Table cells, secondary button outline"
      },
      "control": {
        "$value": "{color.neutral.500}",
        "$description": "Inputs, selects, checkboxes. Must reach 3:1 (WCAG 1.4.11)."
      },
      "control-hover": {
        "$value": "{color.neutral.400}"
      },
      "danger": {
        "$value": "{color.red.400}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.accent.400}",
        "$description": "2px ring on every focusable element"
      },
      "ring-offset": {
        "$value": "{color.neutral.950}",
        "$description": "2px gap between element and ring"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$value": "{color.accent.400}",
          "$description": "One primary action per view"
        },
        "bg-hover": {
          "$value": "{color.accent.300}"
        },
        "bg-active": {
          "$value": "{color.accent.200}"
        },
        "fg": {
          "$value": "{color.accent.950}",
          "$description": "Dark label on a light accent button: white would fail contrast here"
        }
      },
      "secondary": {
        "bg": {
          "$value": "{color.neutral.900}"
        },
        "bg-hover": {
          "$value": "{color.neutral.800}"
        },
        "bg-active": {
          "$value": "{color.neutral.700}"
        },
        "fg": {
          "$value": "{color.neutral.50}"
        },
        "border": {
          "$value": "{color.neutral.500}",
          "$description": "Must reach 3:1 against the page: the outline is the only edge of the button (WCAG 1.4.11)."
        }
      },
      "ghost": {
        "bg-hover": {
          "$value": "{color.neutral.800}"
        },
        "bg-active": {
          "$value": "{color.neutral.700}"
        },
        "fg": {
          "$value": "{color.neutral.200}"
        }
      },
      "danger": {
        "bg": {
          "$value": "{color.red.400}",
          "$description": "Destructive actions only"
        },
        "bg-hover": {
          "$value": "{color.red.300}"
        },
        "bg-active": {
          "$value": "{color.red.200}"
        },
        "fg": {
          "$value": "{color.red.950}",
          "$description": "Dark label on a light red button"
        }
      },
      "disabled": {
        "bg": {
          "$value": "{color.neutral.800}"
        },
        "fg": {
          "$value": "{color.neutral.600}"
        }
      }
    },
    "selected": {
      "bg": {
        "$value": "{color.accent.950}",
        "$description": "Selected row, active nav item. Always pair with selected.indicator."
      },
      "fg": {
        "$value": "{color.accent.200}"
      },
      "indicator": {
        "$value": "{color.accent.300}",
        "$description": "Non-color cue for selection (left bar, check, underline). The tint alone is not enough (WCAG 1.4.1)."
      }
    },
    "status": {
      "success": {
        "bg": {
          "$value": "{color.green.950}"
        },
        "border": {
          "$value": "{color.green.800}"
        },
        "fg": {
          "$value": "{color.green.300}"
        },
        "solid": {
          "$value": "{color.green.400}"
        },
        "on-solid": {
          "$value": "{color.green.950}"
        }
      },
      "warning": {
        "bg": {
          "$value": "{color.amber.950}"
        },
        "border": {
          "$value": "{color.amber.800}"
        },
        "fg": {
          "$value": "{color.amber.300}"
        },
        "solid": {
          "$value": "{color.amber.400}"
        },
        "on-solid": {
          "$value": "{color.amber.950}",
          "$description": "Warning fills take dark text, never white"
        }
      },
      "danger": {
        "bg": {
          "$value": "{color.red.950}"
        },
        "border": {
          "$value": "{color.red.800}"
        },
        "fg": {
          "$value": "{color.red.300}"
        },
        "solid": {
          "$value": "{color.red.400}"
        },
        "on-solid": {
          "$value": "{color.red.950}"
        }
      },
      "info": {
        "$description": "Neutral, not accent: the accent is reserved for actions.",
        "bg": {
          "$value": "{color.neutral.900}"
        },
        "border": {
          "$value": "{color.neutral.700}"
        },
        "fg": {
          "$value": "{color.neutral.300}"
        },
        "solid": {
          "$value": "{color.neutral.300}"
        },
        "on-solid": {
          "$value": "{color.neutral.950}"
        }
      }
    }
  },
  "text-style": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.5xl}",
        "lineHeight": "{font.line-height.5xl}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "heading-xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.3xl}",
        "lineHeight": "{font.line-height.3xl}",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "lineHeight": "{font.line-height.2xl}",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "lineHeight": "{font.line-height.xl}",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "heading-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "lineHeight": "{font.line-height.lg}",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "lineHeight": "{font.line-height.lg}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "body-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "lineHeight": "{font.line-height.md}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "Default text"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.sm}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "label-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.sm}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "Buttons, form labels, tabs"
    },
    "label-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.line-height.xs}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "Badges, small buttons"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.line-height.xs}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "overline": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.line-height.xs}",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": "{font.letter-spacing.wide}"
      },
      "$description": "Uppercase section labels"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.sm}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    }
  }
}
