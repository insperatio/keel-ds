{
  "$description": "Keel semantic tokens, light mode. Every value is an alias to a primitive; no raw values allowed here. Components use ONLY these names. Dark mode (Day 8) re-points the same names.",
  "color": {
    "$type": "color",
    "text": {
      "primary": { "$value": "{color.slate.900}", "$description": "Body text and headings" },
      "secondary": { "$value": "{color.slate.600}", "$description": "Supporting text, descriptions" },
      "tertiary": { "$value": "{color.slate.500}", "$description": "Captions, metadata, placeholders. Lightest readable gray." },
      "disabled": { "$value": "{color.slate.400}", "$description": "Disabled labels only (exempt from contrast rules)" },
      "inverse": { "$value": "{color.base.white}", "$description": "Text on surface.inverse" },
      "link": { "$value": "{color.indigo.600}" },
      "link-hover": { "$value": "{color.indigo.700}" },
      "danger": { "$value": "{color.red.700}", "$description": "Error messages" },
      "success": { "$value": "{color.green.700}" },
      "warning": { "$value": "{color.amber.700}" }
    },
    "surface": {
      "page": { "$value": "{color.base.white}", "$description": "App background" },
      "subtle": { "$value": "{color.slate.50}", "$description": "Sidebars, table headers, quiet sections" },
      "raised": { "$value": "{color.base.white}", "$description": "Cards (pair with border.subtle or shadow.md)" },
      "sunken": { "$value": "{color.slate.100}", "$description": "Wells, code blocks, inset areas" },
      "overlay": { "$value": "{color.base.white}", "$description": "Popovers, menus, dialogs (pair with shadow.lg or xl)" },
      "inverse": { "$value": "{color.slate.900}", "$description": "Tooltips, toasts on light pages" }
    },
    "border": {
      "subtle": { "$value": "{color.slate.200}", "$description": "Dividers, card outlines (decorative)" },
      "default": { "$value": "{color.slate.300}", "$description": "Table cells, secondary button outline" },
      "control": { "$value": "{color.slate.400}", "$description": "Inputs, selects, checkboxes. Must reach 3:1 (WCAG 1.4.11)." },
      "control-hover": { "$value": "{color.slate.500}" }
    },
    "focus": {
      "ring": { "$value": "{color.indigo.500}", "$description": "2px ring on every focusable element" },
      "ring-offset": { "$value": "{color.base.white}", "$description": "2px gap between element and ring" }
    },
    "action": {
      "primary": {
        "bg": { "$value": "{color.indigo.600}", "$description": "One primary action per view" },
        "bg-hover": { "$value": "{color.indigo.700}" },
        "bg-active": { "$value": "{color.indigo.800}" },
        "fg": { "$value": "{color.base.white}" }
      },
      "secondary": {
        "bg": { "$value": "{color.base.white}" },
        "bg-hover": { "$value": "{color.slate.100}" },
        "bg-active": { "$value": "{color.slate.200}" },
        "fg": { "$value": "{color.slate.900}" },
        "border": { "$value": "{color.slate.300}" }
      },
      "ghost": {
        "bg-hover": { "$value": "{color.slate.100}" },
        "bg-active": { "$value": "{color.slate.200}" },
        "fg": { "$value": "{color.slate.700}" }
      },
      "danger": {
        "bg": { "$value": "{color.red.600}", "$description": "Destructive actions only" },
        "bg-hover": { "$value": "{color.red.700}" },
        "bg-active": { "$value": "{color.red.800}" },
        "fg": { "$value": "{color.base.white}" }
      },
      "disabled": {
        "bg": { "$value": "{color.slate.100}" },
        "fg": { "$value": "{color.slate.400}" }
      }
    },
    "selected": {
      "bg": { "$value": "{color.indigo.50}", "$description": "Selected row, active nav item" },
      "fg": { "$value": "{color.indigo.700}" }
    },
    "status": {
      "success": {
        "bg": { "$value": "{color.green.50}" },
        "border": { "$value": "{color.green.200}" },
        "fg": { "$value": "{color.green.700}" },
        "solid": { "$value": "{color.green.600}" },
        "on-solid": { "$value": "{color.base.white}" }
      },
      "warning": {
        "bg": { "$value": "{color.amber.50}" },
        "border": { "$value": "{color.amber.200}" },
        "fg": { "$value": "{color.amber.700}" },
        "solid": { "$value": "{color.amber.300}" },
        "on-solid": { "$value": "{color.amber.950}", "$description": "Warning fills take dark text, never white" }
      },
      "danger": {
        "bg": { "$value": "{color.red.50}" },
        "border": { "$value": "{color.red.200}" },
        "fg": { "$value": "{color.red.700}" },
        "solid": { "$value": "{color.red.600}" },
        "on-solid": { "$value": "{color.base.white}" }
      },
      "info": {
        "$description": "Neutral, not indigo: indigo is reserved for actions.",
        "bg": { "$value": "{color.slate.100}" },
        "border": { "$value": "{color.slate.300}" },
        "fg": { "$value": "{color.slate.700}" },
        "solid": { "$value": "{color.slate.700}" },
        "on-solid": { "$value": "{color.base.white}" }
      }
    }
  },
  "text-style": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.5xl}", "lineHeight": "{font.line-height.5xl}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.letter-spacing.tight}" } },
    "heading-xl": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.3xl}", "lineHeight": "{font.line-height.3xl}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letter-spacing.tight}" } },
    "heading-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.2xl}", "lineHeight": "{font.line-height.2xl}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letter-spacing.tight}" } },
    "heading-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xl}", "lineHeight": "{font.line-height.xl}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "heading-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "lineHeight": "{font.line-height.lg}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "body-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "lineHeight": "{font.line-height.lg}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "body-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "lineHeight": "{font.line-height.md}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "Default text" },
    "body-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "lineHeight": "{font.line-height.sm}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "label-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "lineHeight": "{font.line-height.sm}", "fontWeight": "{font.weight.medium}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "Buttons, form labels, tabs" },
    "label-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.xs}", "fontWeight": "{font.weight.medium}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "Badges, small buttons" },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.xs}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letter-spacing.normal}" } },
    "overline": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.xs}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.letter-spacing.wide}" }, "$description": "Uppercase section labels" },
    "code": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.sm}", "lineHeight": "{font.line-height.sm}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.letter-spacing.normal}" } }
  }
}
