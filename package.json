{
  "name": "keel-ds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tokens": "npm run tokens:brand && npm run tokens:build && npm run figma:plugin && npm run tokens:check",
    "tokens:brand": "node scripts/brand.mjs",
    "tokens:brand:check": "node scripts/brand.mjs --check",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:build:check": "node scripts/build-tokens.mjs --check",
    "tokens:check": "node scripts/check-tokens.mjs",
    "figma:plugin": "node scripts/figma-plugin.mjs",
    "figma:diff": "node scripts/figma-diff.mjs",
    "check:ui": "npm run build && node scripts/check-ui.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "oxlint": "^1.90.0",
    "playwright": "1.63.0",
    "shadcn": "^4.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
